# Copy this file to .env and fill in the values from your Firebase
# project's web app config (Project settings -> your app -> SDK setup and
# configuration). These are public client identifiers, not secrets — real
# access control lives in Firestore security rules — but each deployment
# still needs its own project's values here.
#
# If any of these are missing, the app runs fine with cloud save disabled:
# both game modes fall back to their existing local-only saves (IndexedDB
# for story mode, localStorage for Lagos Life).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
